// Secure Document Access Models
model SecureDocumentToken {
  id              String                 @id @default(uuid())
  token           String                 @unique
  documentType    String                 @map("document_type")
  documentId      String                 @map("document_id")
  customerId      String                 @map("customer_id")
  expiresAt       DateTime               @map("expires_at")
  accessCount     Int                    @default(0) @map("access_count")
  lastAccessedAt  DateTime?              @map("last_accessed_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  
  customer        Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accessLogs      DocumentAccessLog[]

  @@index([token])
  @@index([customerId])
  @@index([expiresAt])
  @@map("secure_document_tokens")
}

model DocumentAccessLog {
  id         String   @id @default(uuid())
  token      String
  success    Boolean
  reason     String?
  accessedAt DateTime @default(now()) @map("accessed_at")
  
  tokenRecord SecureDocumentToken @relation(fields: [token], references: [token], onDelete: Cascade)

  @@index([token])
  @@index([accessedAt])
  @@map("document_access_logs")
}


// =====================================================
// Customer Business Profile Models
// Added: 2026-02-20
// Purpose: Store comprehensive business profile data from Excel parsing
// =====================================================

model CustomerBusinessProfile {
  id                    String   @id @default(uuid())
  customerId            String   @map("customer_id")
  
  // Source Information
  sourceFileName        String   @map("source_file_name")
  sourceFileHash        String?  @map("source_file_hash")
  documentId            String?  @map("document_id")
  
  // Processing Metadata
  parserVersion         String   @default("v3.0") @map("parser_version")
  matchConfidence       Decimal  @map("match_confidence") @db.Decimal(5, 4)
  sheetsParsed          String[] @map("sheets_parsed")
  warnings              String[] @default([])
  
  // Profile Status
  status                ProfileStatus @default(DRAFT)
  reviewStatus          ReviewStatus  @default(PENDING)
  reviewedBy            String?  @map("reviewed_by")
  reviewedAt            DateTime? @map("reviewed_at")
  reviewNotes           String?  @map("review_notes")
  
  // Versioning
  version               Int      @default(1)
  isLatest              Boolean  @default(true) @map("is_latest")
  previousVersionId     String?  @map("previous_version_id")
  
  // Enhanced Data (JSON)
  enhancedData          Json?    @map("enhanced_data")
  recommendation        String?  @db.Text
  metadata              Json?
  
  // Timestamps
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")
  
  // Relations
  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  document              Document? @relation(fields: [documentId], references: [id])
  reviewer              User?    @relation("ProfileReviewer", fields: [reviewedBy], references: [id])
  previousVersion       CustomerBusinessProfile? @relation("ProfileVersions", fields: [previousVersionId], references: [id])
  nextVersions          CustomerBusinessProfile[] @relation("ProfileVersions")
  
  // Detailed Data Relations
  shareholders          CustomerShareholder[]
  loanRequests          CustomerLoanRequest[]
  collaterals           CustomerCollateral[]
  executives            CustomerExecutive[]
  suppliers             CustomerSupplier[]
  customers             CustomerCustomer[]
  dscrAnalysis          CustomerDSCRAnalysis[]
  approvalComments      CustomerApprovalComment[]
  
  @@unique([customerId, version])
  @@index([customerId, isLatest])
  @@index([status])
  @@index([reviewStatus])
  @@index([createdAt])
  @@map("customer_business_profiles")
}

model CustomerShareholder {
  id                    String   @id @default(uuid())
  profileId             String   @map("profile_id")
  
  // Shareholder Information
  name                  String
  nationalId            String?  @map("national_id")
  sharePercentage       Decimal  @map("share_percentage") @db.Decimal(5, 2)
  shareValue            Decimal  @map("share_value") @db.Decimal(15, 2)
  shareType             String?  @default("ORDINARY") @map("share_type")
  
  // Authority
  hasSigningAuthority   Boolean  @default(false) @map("has_signing_authority")
  signingConditions     String?  @map("signing_conditions")
  position              String?
  
  // Contact
  phone                 String?
  email                 String?
  address               String?
  
  // Metadata
  order                 Int      @default(0)
  createdAt             DateTime @default(now()) @map("created_at")
  
  profile               CustomerBusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  @@index([profileId])
  @@index([name])
  @@map("customer_shareholders")
}

model CustomerExecutive {
