model CollectionAction {
  id                      String                    @id @default(uuid())
  customerId              String                    @map("customer_id")
  loanId                  String?                   @map("loan_id")
  scheduleId              String?                   @map("schedule_id")
  actionType              CollectionActionType      @map("action_type")
  status                  CollectionActionStatus    @default(PENDING)
  priority                CollectionPriority        @default(MEDIUM)
  agentId                 String                    @map("agent_id")
  notes                   String?
  amount                  Decimal?                  @db.Decimal(15, 2)
  followUpDate            DateTime?                 @map("follow_up_date")
  estimatedDurationMinutes Int?                     @map("estimated_duration_minutes")
  requiresApproval        Boolean                   @default(false) @map("requires_approval")
  approvalStatus          CollectionApprovalStatus? @map("approval_status")
  approvedBy              String?                   @map("approved_by")
  approvedAt              DateTime?                 @map("approved_at")
  rejectionReason         String?                   @map("rejection_reason")
  completedAt             DateTime?                 @map("completed_at")
  result                  String?
  metadata                Json?
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  customer                Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loan                    Loan?                     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  schedule                PaymentSchedule?          @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  agent                   User                      @relation("CollectionAgent", fields: [agentId], references: [id])
  approver                User?                     @relation("CollectionApprover", fields: [approvedBy], references: [id])
  
  history                 CollectionActionHistory[]
  contactLogs             ContactLog[]

  @@index([customerId])
  @@index([loanId])
  @@index([scheduleId])
  @@index([agentId])
  @@index([status])
  @@index([actionType])
  @@index([priority])
  @@index([approvalStatus])
  @@index([createdAt])
  @@index([followUpDate])
  @@map("collection_actions")
}

model CollectionActionHistory {
  id           String           @id @default(uuid())
  actionId     String           @map("action_id")
  statusFrom   String?          @map("status_from")
  statusTo     String           @map("status_to")
  changedBy    String           @map("changed_by")
  changeReason String?          @map("change_reason")
  metadata     Json?
  createdAt    DateTime         @default(now()) @map("created_at")

  action       CollectionAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user         User             @relation("CollectionHistoryUser", fields: [changedBy], references: [id])

  @@index([actionId])
  @@index([createdAt])
  @@map("collection_action_history")
}

