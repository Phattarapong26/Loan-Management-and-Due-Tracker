generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id                 String               @id @default(uuid())
  code               String               @unique
  name               String
  address            String?
  phone              String?
  province           String?              // จังหวัด
  district           String?              // อำเภอ/เขต
  subdistrict        String?              // ตำบล/แขวง
  postalCode         String?              @map("postal_code") // รหัสไปรษณีย์
  status             BranchStatus         @default(ACTIVE)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  aging_analysis     aging_analysis[]
  budget_consumption budget_consumption[]
  events             CalendarEvent[]
  customers          Customer[]
  expenses           Expense[]
  loans              Loan[]
  users              User[]

  @@map("branches")
}

model User {
  id                                                        String                           @id @default(uuid())
  email                                                     String                           @unique
  passwordHash                                              String                           @map("password_hash")
  firstName                                                 String                           @map("first_name")
  lastName                                                  String                           @map("last_name")
  phoneNumber                                               String?                          @map("phone_number")
  avatar                                                    String?                          @map("avatar")
  role                                                      UserRole                         @default(CUSTOMER)
  status                                                    UserStatus                       @default(ACTIVE)
  branchId                                                  String?                          @map("branch_id")
  mustChangePassword                                        Boolean                          @default(false) @map("must_change_password")
  passwordChangedAt                                         DateTime?                        @map("password_changed_at")
  nationalId                                                String?                          @map("national_id")
  lineUserId                                                String?                          @unique @map("line_user_id")
  lineLinkedAt                                              DateTime?                        @map("line_linked_at")
  lineActive                                                Boolean                          @default(true) @map("line_active")
  lineNotificationsEnabled                                  Boolean                          @default(true) @map("line_notifications_enabled")
  monthlyTarget                                             Decimal?                         @default(100000.00) @map("monthly_target") @db.Decimal(15, 2)
  createdAt                                                 DateTime                         @default(now()) @map("created_at")
  updatedAt                                                 DateTime                         @updatedAt @map("updated_at")
  lastLoginAt                                               DateTime?                        @map("last_login_at")
  aging_analysis                                            aging_analysis[]
  aml_checks_aml_checks_performed_byTousers                 aml_checks[]                     @relation("aml_checks_performed_byTousers")
  aml_checks_aml_checks_reviewed_byTousers                  aml_checks[]                     @relation("aml_checks_reviewed_byTousers")
  auditLogs                                                 AuditLog[]
  budget_consumption_budget_consumption_processed_byTousers budget_consumption[]             @relation("budget_consumption_processed_byTousers")
  budget_consumption_budget_consumption_released_byTousers  budget_consumption[]             @relation("budget_consumption_released_byTousers")
  createdEvents                                             CalendarEvent[]                  @relation("EventCreator")
  collection_workflow_steps                                 collection_workflow_steps[]
  contactLogs                                               ContactLog[]                     @relation("ContactOfficer")
  credit_line_drawdowns                                     credit_line_drawdowns[]
  credit_lines                                              credit_lines[]
  customers                                                 Customer[]
  data_access_logs                                          data_access_logs[]
  approvedExpenses                                          Expense[]                        @relation("ExpenseApprover")
  createdExpenses                                           Expense[]                        @relation("ExpenseCreator")
  reimbursedExpenses                                        Expense[]                        @relation("ExpenseReimburser")
  rejectedExpenses                                          Expense[]                        @relation("ExpenseRejector")
  loan_approval_workflow                                    loan_approval_workflow[]
  approvedDisbursements                                     LoanDisbursement[]               @relation("DisbursementApprover")
  createdDisbursements                                      LoanDisbursement[]               @relation("DisbursementCreator")
  disbursedDisbursements                                    LoanDisbursement[]               @relation("DisbursementDisburser")
  rejectedDisbursements                                     LoanDisbursement[]               @relation("DisbursementRejector")
  approvedLoans                                             Loan[]                           @relation("LoanApprover")
  createdLoans                                              Loan[]                           @relation("LoanOfficer")
  generatedInvoices                                         NextPaymentInvoice[]             @relation("InvoiceGenerator")
  sentInvoices                                              NextPaymentInvoice[]             @relation("InvoiceSender")
  notifications                                             Notification[]                   @relation("NotificationUser")
  paymentReceipts                                           PaymentReceipt[]                 @relation("ReceiptIssuer")
  createdPayments                                           Payment[]                        @relation("PaymentCreator")
  principal_prepayments                                     principal_prepayments[]
  product_budgets_product_budgets_budget_ownerTousers       product_budgets[]                @relation("product_budgets_budget_ownerTousers")
  product_budgets_product_budgets_created_byTousers         product_budgets[]                @relation("product_budgets_created_byTousers")
  securityAlerts                                            SecurityAlert[]
  securityEvents                                            SecurityEvent[]
  sessions                                                  Session[]
  suspicious_transaction_reports                            suspicious_transaction_reports[]
  task_assignments_task_assignments_assigned_byTousers      task_assignments[]               @relation("task_assignments_assigned_byTousers")
  task_assignments_task_assignments_assigned_toTousers      task_assignments[]               @relation("task_assignments_assigned_toTousers")
  transactions                                              Transaction[]
  reviewedProfiles                                          CustomerBusinessProfile[]        @relation("ProfileReviewer")
  createdApprovalLimits                                     ApprovalLimit[]                  @relation("ApprovalLimitCreator")
  createdProductConfigs                                     ProductConfig[]                  @relation("ProductConfigCreator")
  conversationStates                                        ConversationState[]              @relation("ConversationUser")
  registrationTokens                                        RegistrationToken[]              @relation("RegistrationTokenUser")
  blockedIPs                                                BlockedIP[]                      @relation("IPBlocker")
  lineAuditLogsAsUser                                       LineAuditLog[]                   @relation("LineAuditUser")
  lineAuditLogsAsPerformer                                  LineAuditLog[]                   @relation("LineAuditPerformer")
  collectionActions                                         CollectionAction[]               @relation("CollectionAgent")
  approvedCollectionActions                                 CollectionAction[]               @relation("CollectionApprover")
  collectionActionHistory                                   CollectionActionHistory[]        @relation("CollectionHistoryUser")
  branch                                                    Branch?                          @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("users")
}

model ApprovalLimit {
  id                String   @id @default(uuid())
  role              UserRole
  minAmount         Decimal  @default(0) @map("min_amount") @db.Decimal(15, 2)
  maxAmount         Decimal? @map("max_amount") @db.Decimal(15, 2)
  approvalLevel     String   @map("approval_level")
  requiresNextLevel Boolean  @default(false) @map("requires_next_level")
  slaHours          Int      @default(24) @map("sla_hours")
  status            String   @default("ACTIVE")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  creator           User     @relation("ApprovalLimitCreator", fields: [createdBy], references: [id])

  @@index([role])
  @@index([status])
  @@index([createdBy])
  @@map("approval_limits")
}

model Session {
  id                     String    @id @default(uuid())
  userId                 String    @map("user_id")
  token                  String    @unique
  refreshToken           String?   @unique @map("refresh_token")
  previousToken          String?   @map("previous_token")
  previousTokenExpiresAt DateTime? @map("previous_token_expires_at")
  previousRefreshToken   String?   @map("previous_refresh_token")
  ipAddress              String?   @map("ip_address")
  userAgent              String?   @map("user_agent")
  isValid                Boolean   @default(true) @map("is_valid")
  expiresAt              DateTime  @map("expires_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([previousToken])
  @@index([previousTokenExpiresAt])
  @@map("sessions")
}

model Transaction {
  id                             String                           @id @default(uuid())
  userId                         String                           @map("user_id")
  loanId                         String?                          @map("loan_id")
  type                           TransactionType
  amount                         Decimal                          @db.Decimal(15, 2)
  currency                       String                           @default("THB")
  status                         TransactionStatus                @default(PENDING)
  fromAccount                    String?                          @map("from_account")
  toAccount                      String?                          @map("to_account")
  reference                      String?                          @unique
  description                    String?
  metadata                       Json?
  processedAt                    DateTime?                        @map("processed_at")
  createdAt                      DateTime                         @default(now()) @map("created_at")
  updatedAt                      DateTime                         @updatedAt @map("updated_at")
  suspicious_transaction_reports suspicious_transaction_reports[]
  loan                           Loan?                            @relation(fields: [loanId], references: [id])
  user                           User                             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([loanId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

model NextPaymentInvoice {
  id                String           @id @default(uuid())
  invoiceNumber     String           @unique @map("invoice_number")
  loanId            String           @map("loan_id")
  customerId        String           @map("customer_id")
  paymentScheduleId String           @map("payment_schedule_id")
  invoiceData       Json             @map("invoice_data")
  status            InvoiceStatus    @default(PENDING)
  generatedBy       String           @map("generated_by")
  sentAt            DateTime?        @map("sent_at")
  sentVia           String?          @map("sent_via")
  sentBy            String?          @map("sent_by")
  paidAt            DateTime?        @map("paid_at")
  paidAmount        Decimal?         @map("paid_amount") @db.Decimal(15, 2)
  paymentMethod     String?          @map("payment_method")
  receiptNumber     String?          @map("receipt_number")
  validUntil        DateTime         @map("valid_until")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  customer          Customer         @relation(fields: [customerId], references: [id])
  generator         User             @relation("InvoiceGenerator", fields: [generatedBy], references: [id])
  loan              Loan             @relation(fields: [loanId], references: [id])
  paymentSchedule   PaymentSchedule  @relation(fields: [paymentScheduleId], references: [id])
  sender            User?            @relation("InvoiceSender", fields: [sentBy], references: [id])
  paymentReceipts   PaymentReceipt[]

  @@index([loanId])
  @@index([customerId])
  @@index([paymentScheduleId])
  @@index([status])
  @@index([createdAt])
  @@map("next_payment_invoices")
}

model PaymentReceipt {
  id            String              @id @default(uuid())
  receiptNumber String              @unique @map("receipt_number")
  paymentId     String              @map("payment_id")
  loanId        String              @map("loan_id")
  customerId    String              @map("customer_id")
  invoiceId     String?             @map("invoice_id")
  amount        Decimal             @db.Decimal(15, 2)
  paymentDate   DateTime            @map("payment_date")
  paymentMethod String              @map("payment_method")
  receiptData   Json                @map("receipt_data")
  status        ReceiptStatus       @default(ISSUED)
  issuedBy      String              @map("issued_by")
  issuedAt      DateTime            @default(now()) @map("issued_at")
  sentAt        DateTime?           @map("sent_at")
  sentVia       String?             @map("sent_via")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  customer      Customer            @relation(fields: [customerId], references: [id])
  invoice       NextPaymentInvoice? @relation(fields: [invoiceId], references: [id])
  issuer        User                @relation("ReceiptIssuer", fields: [issuedBy], references: [id])
  loan          Loan                @relation(fields: [loanId], references: [id])
  payment       Payment             @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([loanId])
  @@index([customerId])
  @@index([receiptNumber])
  @@index([paymentDate])
  @@map("payment_receipts")
}

model InterestRateTier {
  id              String       @id @default(uuid())
  loanProductId   String?      @map("loan_product_id")
  tierName        String       @map("tier_name")
  minAmount       Decimal      @map("min_amount") @db.Decimal(15, 2)
  maxAmount       Decimal?     @map("max_amount") @db.Decimal(15, 2)
  interestRate    Decimal      @map("interest_rate") @db.Decimal(5, 4)
  gracePeriodDays Int          @default(0) @map("grace_period_days")
  effectiveFrom   DateTime     @map("effective_from")
  effectiveUntil  DateTime?    @map("effective_until")
  status          String       @default("ACTIVE")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  loanProduct     LoanProduct? @relation("LoanProductTiers", fields: [loanProductId], references: [id])

  @@index([loanProductId])
  @@index([minAmount, maxAmount])
  @@index([effectiveFrom, effectiveUntil])
  @@index([status])
  @@map("interest_rate_tiers")
}

model YearInterestTier {
  id            String      @id @default(uuid())
  loanProductId String      @map("loan_product_id")
  tierType      String      @map("tier_type")
  startYear     Int         @map("start_year")
  endYear       String      @map("end_year")
  rate          Decimal?    @map("rate") @db.Decimal(5, 4)
  formula       String?     @map("formula")
  minRate       Decimal?    @map("min_rate") @db.Decimal(5, 4)
  maxRate       Decimal?    @map("max_rate") @db.Decimal(5, 4)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  loanProduct   LoanProduct @relation("YearBasedTiers", fields: [loanProductId], references: [id], onDelete: Cascade)

  @@index([loanProductId])
  @@index([startYear])
  @@map("year_interest_tiers")
}

model LoanInterestHistory {
  id                 String   @id @default(uuid())
  loanId             String   @map("loan_id")
  paymentNumber      Int      @map("payment_number")
  outstandingBalance Decimal  @map("outstanding_balance") @db.Decimal(15, 2)
  appliedRate        Decimal  @map("applied_rate") @db.Decimal(5, 4)
  tierName           String?  @map("tier_name")
  gracePeriodDays    Int      @default(0) @map("grace_period_days")
  interestAmount     Decimal  @map("interest_amount") @db.Decimal(15, 2)
  calculatedAt       DateTime @default(now()) @map("calculated_at")
  effectiveDate      DateTime @map("effective_date")
  loan               Loan     @relation(fields: [loanId], references: [id])

  @@index([loanId])
  @@index([paymentNumber])
  @@index([effectiveDate])
  @@map("loan_interest_history")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  changes   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model Customer {
  id                             String                           @id @default(uuid())
  userId                         String?                          @map("user_id")
  branchId                       String                           @map("branch_id")
  customerCode                   String                           @unique @map("customer_code")
  businessName                   String                           @map("business_name")
  businessType                   String?                          @map("business_type")
  business_registration_date     DateTime?                        @db.Date
  business_registration_type     String?                          @db.VarChar(50)
  registered_capital             Decimal?                         @db.Decimal(15, 2)
  business_size                  String?                          @db.VarChar(20)
  industry_code                  String?                          @db.VarChar(10)
  business_age_years             Int?
  number_of_employees            Int?
  phone                          String
  email                          String?
  address                        String?
  business_address               String?
  business_phone                 String?
  thaiId                         String?                          @map("thai_id")
  taxId                          String                           @unique @map("tax_id")
  avatar                         String?                          @map("avatar")
  shareholders                   Json?
  signatories                    Json?
  annualRevenue                  Decimal?                         @map("annual_revenue") @db.Decimal(15, 2)
  netProfit                      Decimal?                         @map("net_profit") @db.Decimal(15, 2)
  totalAssets                    Decimal?                         @map("total_assets") @db.Decimal(15, 2)
  totalLiabilities               Decimal?                         @map("total_liabilities") @db.Decimal(15, 2)
  debtToEquityRatio              Decimal?                         @map("debt_to_equity_ratio") @db.Decimal(5, 2)
  aiExtractedData                Json?                            @map("ai_extracted_data")
  aiConfidenceScore              Decimal?                         @map("ai_confidence_score") @db.Decimal(5, 2)
  aiProcessedAt                  DateTime?                        @map("ai_processed_at")
  aiWarnings                     String[]                         @default([]) @map("ai_warnings")
  status                         CustomerStatus                   @default(ACTIVE)
  documentComplete               Boolean                          @default(false) @map("document_complete")
  lineUserId                     String?                          @unique @map("line_user_id")
  lineLinkedAt                   DateTime?                        @map("line_linked_at")
  createdAt                      DateTime                         @default(now()) @map("created_at")
  updatedAt                      DateTime                         @updatedAt @map("updated_at")
  createdBy                      String                           @map("created_by")
  aging_analysis                 aging_analysis[]
  aml_checks                     aml_checks[]
  events                         CalendarEvent[]
  contacts                       ContactLog[]
  credit_lines                   credit_lines[]
  customerActiveProducts         CustomerActiveProduct[]
  bankStatements                 CustomerBankStatement[]
  businessHistories              CustomerBusinessHistory[]
  comments                       CustomerComment[]
  creditBureaus                  CustomerCreditBureau[]
  financialStatements            CustomerFinancialStatement[]
  investments                    CustomerInvestment[]
  projections                    CustomerProjection[]
  vatRecords                     CustomerVATRecord[]
  workingCapitals                CustomerWorkingCapital[]
  branch                         Branch                           @relation(fields: [branchId], references: [id])
  user                           User?                            @relation(fields: [userId], references: [id])
  data_access_logs               data_access_logs[]
  documents                      Document[]
  invoiceAccessLogs              InvoiceAccessLog[]
  secureDocumentTokens           SecureDocumentToken[]
  invoices                       Invoice[]
  loans                          Loan[]
  nextPaymentInvoices            NextPaymentInvoice[]
  paymentReceipts                PaymentReceipt[]
  privacy_consents               privacy_consents[]
  suspicious_transaction_reports suspicious_transaction_reports[]
  businessProfiles               CustomerBusinessProfile[]
  collectionActions              CollectionAction[]
  lineAuditLogs                  LineAuditLog[]                   @relation("LineAuditCustomer")

  @@index([branchId])
  @@index([userId])
  @@index([status])
  @@index([branchId, status, createdAt], map: "idx_customers_branch_status")
  @@index([businessName], map: "Customer_businessName_idx")
  @@map("customers")
}

model Loan {
  id                          String                   @id @default(uuid())
  customerId                  String                   @map("customer_id")
  branchId                    String                   @map("branch_id")
  officerId                   String                   @map("officer_id")
  contract_number             String?                  @unique
  principal                   Decimal                  @db.Decimal(15, 2)
  interestRate                Decimal                  @map("interest_rate") @db.Decimal(5, 2)
  termMonths                  Int                      @map("term_months")
  currentPrincipal            Decimal?                 @map("current_principal") @db.Decimal(15, 2)
  version                     Int                      @default(1)
  interestCalculationMethod   String?                  @default("DYNAMIC_PRINCIPAL") @map("interest_calculation_method")
  lastInterestCalculationDate DateTime?                @map("last_interest_calculation_date")
  accumulatedInterest         Decimal?                 @default(0) @map("accumulated_interest") @db.Decimal(15, 2)
  paymentDay                  Int                      @default(1) @map("payment_day")
  firstPaymentDate            DateTime?                @map("first_payment_date")
  paymentDayAdjustment        String?                  @default("LAST_DAY") @map("payment_day_adjustment")
  dscr                        Decimal?                 @db.Decimal(5, 2)
  dscrStatus                  String?                  @map("dscr_status")
  monthlyPayment              Decimal?                 @map("monthly_payment") @db.Decimal(15, 2)
  totalInterest               Decimal?                 @map("total_interest") @db.Decimal(15, 2)
  allow_early_payment         Boolean?                 @default(true)
  early_payment_penalty_rate  Decimal?                 @default(0) @db.Decimal(5, 2)
  status                      LoanStatus               @default(PENDING_APPROVAL)
  sla_status                  String?                  @db.VarChar(20)
  sla_deadline                DateTime?
  approvedBy                  String?                  @map("approved_by")
  approvedAt                  DateTime?                @map("approved_at")
  rejectedBy                  String?                  @map("rejected_by")
  rejectedAt                  DateTime?                @map("rejected_at")
  rejectedReason              String?                  @map("rejected_reason")
  approvalLevel               ApprovalLevel            @map("approval_level")
  currentApprovalLevel        ApprovalLevel?           @map("current_approval_level")
  approvalHistory             Json?                    @map("approval_history")
  disbursementDate            DateTime?                @map("disbursement_date")
  maturityDate                DateTime?                @map("maturity_date")
  outstandingBalance          Decimal                  @default(0) @map("outstanding_balance") @db.Decimal(15, 2)
  nextPaymentDate             DateTime?                @map("next_payment_date")
  nextPaymentAmount           Decimal?                 @map("next_payment_amount") @db.Decimal(15, 2)
  lastPaymentDate             DateTime?                @map("last_payment_date")
  overdueDays                 Int                      @default(0) @map("overdue_days")
  totalDisbursed              Decimal                  @default(0) @map("total_disbursed") @db.Decimal(15, 2)
  remainingAmount             Decimal?                 @map("remaining_amount") @db.Decimal(15, 2)
  productConfigId             String?                  @map("product_config_id")
  productConfig               Json?                    @map("product_config")
  loanProductId               String?                  @map("loan_product_id")
  startDate                   DateTime?                @map("start_date")
  endDate                     DateTime?                @map("end_date")
  createdAt                   DateTime                 @default(now()) @map("created_at")
  updatedAt                   DateTime                 @updatedAt @map("updated_at")
  deletedAt                   DateTime?                @map("deleted_at")
  aging_analysis              aging_analysis?
  budget_consumption          budget_consumption[]
  events                      CalendarEvent[]
  contactLogs                 ContactLog[]
  customerActiveProducts      CustomerActiveProduct[]
  invoices                    Invoice[]
  loan_approval_workflow      loan_approval_workflow[]
  disbursements               LoanDisbursement[]
  loanInterestHistory         LoanInterestHistory[]
  approver                    User?                    @relation("LoanApprover", fields: [approvedBy], references: [id])
  branch                      Branch                   @relation(fields: [branchId], references: [id])
  customer                    Customer                 @relation(fields: [customerId], references: [id])
  loanProduct                 LoanProduct?             @relation(fields: [loanProductId], references: [id])
  officer                     User                     @relation("LoanOfficer", fields: [officerId], references: [id])
  nextPaymentInvoices         NextPaymentInvoice[]
  paymentReceipts             PaymentReceipt[]
  paymentSchedule             PaymentSchedule[]
  paymentTimelineEvents       PaymentTimelineEvent[]
  payments                    Payment[]
  principal_prepayments       principal_prepayments[]
  transactions                Transaction[]
  loanRequests                CustomerLoanRequest[]
  promptPayQRCodes            PromptPayQRCode[]
  collectionActions           CollectionAction[]

  @@index([customerId])
  @@index([branchId])
  @@index([officerId])
  @@index([status])
  @@index([productConfigId])
  @@index([loanProductId])
  @@index([currentPrincipal])
  @@index([status, createdAt, disbursementDate], map: "idx_loans_status_dates")
  @@index([deletedAt])
  @@index([branchId], map: "Loan_branchId_idx")
  @@index([status], map: "Loan_status_idx")
  @@map("loans")
}

model PaymentSchedule {
  id                     String                  @id @default(uuid())
  loanId                 String                  @map("loan_id")
  paymentNumber          Int                     @map("payment_number")
  paymentDate            DateTime                @map("payment_date")
  principalAmount        Decimal                 @map("principal_amount") @db.Decimal(15, 2)
  interestAmount         Decimal                 @map("interest_amount") @db.Decimal(15, 2)
  totalPayment           Decimal                 @map("total_payment") @db.Decimal(15, 2)
  remainingBalance       Decimal                 @map("remaining_balance") @db.Decimal(15, 2)
  version                Int                     @default(1)
  status                 PaymentScheduleStatus   @default(UNPAID)
  paidAt                 DateTime?               @map("paid_at")
  statementNumber        String?                 @map("statement_number")
  daysOverdue            Int                     @default(0) @map("days_overdue")
  penaltyAmount          Decimal                 @default(0) @map("penalty_amount") @db.Decimal(15, 2)
  compoundInterestAmount Decimal                 @default(0) @map("compound_interest_amount") @db.Decimal(15, 2)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  invoices               Invoice[]
  nextPaymentInvoices    NextPaymentInvoice[]
  loan                   Loan                    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  paymentTimelineEvents  PaymentTimelineEvent[]
  payments               Payment[]
  principal_prepayments  principal_prepayments[]
  collectionActions      CollectionAction[]

  @@index([loanId])
  @@index([paymentDate])
  @@index([status])
  @@index([daysOverdue])
  @@index([statementNumber])
  @@index([status], map: "PaymentSchedule_status_idx")
  @@map("payment_schedules")
}

model Payment {
  id                String           @id @default(uuid())
  loanId            String           @map("loan_id")
  paymentScheduleId String?          @map("payment_schedule_id")
  amount            Decimal          @db.Decimal(15, 2)
  paymentDate       DateTime         @map("payment_date")
  paymentMethod     String           @map("payment_method") @db.VarChar(50)
