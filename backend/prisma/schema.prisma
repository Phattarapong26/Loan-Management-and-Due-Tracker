  principalPayment      Decimal  @map("principal_payment") @db.Decimal(15, 2)
  interestPayment       Decimal  @map("interest_payment") @db.Decimal(15, 2)
  totalDebtService      Decimal  @map("total_debt_service") @db.Decimal(15, 2)
  
  // DSCR Calculation
  dscrRatio             Decimal  @map("dscr_ratio") @db.Decimal(5, 2)
