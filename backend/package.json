{
  "name": "sme-bank-backend",
  "version": "1.0.0",
  "description": "Production-ready banking backend with Fastify + TypeScript",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npx prisma generate && tsup",
    "start": "node dist/server.js",
    "postinstall": "npx prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:unit:interest": "jest --testPathPattern=__tests__/unit/interest-rate",
    "test:integration": "jest --testPathPattern=__tests__/integration --runInBand",
    "test:worst-case": "jest --testPathPattern=worst-case-scenarios --runInBand --verbose",
    "test:real-world": "jest --testPathPattern=real-world-scenarios --runInBand --verbose",
    "test:all-scenarios": "jest --testPathPattern='(worst-case|real-world)' --runInBand --verbose",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "prisma:seed": "tsx prisma/seed.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "eslint src --ext .ts --rule '@typescript-eslint/no-explicit-any: off' --rule 'no-useless-escape: off' --rule 'no-misleading-character-class: off' --rule 'no-case-declarations: off' --rule 'no-control-regex: off'",
    "format": "prettier --write \"src/**/*.ts\"",
    "rich-menu:init": "tsx src/scripts/init-rich-menus.ts",
    "rich-menu:init-enhanced": "tsx src/scripts/init-rich-menus-enhanced.ts",
    "rich-menu:reinit-enhanced": "tsx src/scripts/reinit-enhanced-rich-menus.ts",
    "rich-menu:update-users": "tsx src/scripts/update-existing-users-rich-menu.ts",
    "rich-menu:test": "tsx src/scripts/test-all-rich-menus.ts",
    "rich-menu:upload": "tsx src/scripts/upload-rich-menu-images.ts",
    "rich-menu:verify": "tsx src/scripts/verify-production-ready.ts",
    "rich-menu:reset": "tsx src/scripts/reset-rich-menus-simple.ts",
    "rich-menu:delete-all": "tsx src/scripts/delete-all-rich-menus.ts",
    "rich-menu:update-custom": "tsx scripts/rich-menu/update-all-rich-menus-custom.ts",
    "test:email": "tsx scripts/test-email.ts",
    "db:reset": "tsx prisma/reset-database.ts",
    "db:reset-keep-products": "tsx prisma/reset-keep-products.ts",
    "db:reset-keep-users": "tsx prisma/reset-keep-users.ts",
    "performance:test": "tsx scripts/test-performance-setup.ts",
    "performance:indexes:budgets": "tsx scripts/apply-performance-indexes-budgets.ts",
    "performance:indexes:disbursements": "tsx scripts/apply-performance-indexes-disbursements.ts",
    "db:check-orphans": "tsx prisma/scripts/check-orphan-data.ts",
    "monitor": "tsx scripts/monitor-performance.ts",
    "monitor:fast": "tsx scripts/monitor-performance.ts --interval=2",
    "monitor:slow": "tsx scripts/monitor-performance.ts --interval=10",
    "db:check-indexes": "tsx scripts/check-database-indexes.ts",
    "db:add-indexes": "tsx scripts/add-missing-indexes.ts",
    "db:er-diagram": "tsx prisma/scripts/generate-er-diagram.ts",
    "db:test-empty": "tsx test-empty-database.ts",
    "db:sync-schema": "tsx scripts/sync-prisma-schema.ts",
    "db:export-schema": "tsx scripts/export-database-schema.ts",
    "db:reset-migrations": "tsx scripts/reset-migrations.ts",
    "seed:admin": "tsx prisma/seed-admin.ts",
    "seed:complete-system": "tsx prisma/seed-complete-system-2025.ts",
    "seed:loan-products": "tsx prisma/seed-loan-products.ts",
    "seed:interest-rates": "tsx prisma/seed-interest-rates.ts",
    "seed:branch-locations": "tsx prisma/seed-branch-locations.ts",
    "seed:update-branches": "tsx prisma/update-existing-branches.ts",
    "seed:production-2025": "tsx run-production-seed-2025.ts",
    "seed:reset-production": "tsx prisma/reset-and-seed-production-2025.ts",
    "seed:setup-prerequisites": "tsx prisma/setup-prerequisites.ts",
    "test:destruction": "tsx tests/load/run-all-destruction-tests.ts",
    "test:race-condition": "tsx tests/load/race-condition-payment.test.ts",
    "test:budget-overcommit": "tsx tests/load/budget-overcommitment.test.ts",
    "test:interest-dup": "tsx tests/load/interest-duplication.test.ts",
    "db:fix-race-conditions": "tsx scripts/apply-race-condition-fixes.ts",
    "db:apply-safe-migrations": "tsx scripts/apply-migrations-safe.ts",
    "db:verify-migrations": "tsx scripts/verify-migrations.ts",
    "db:verify-fixes": "tsx tests/load/verify-fixes.test.ts",
    "db:verify-no-bugs": "tsx tests/load/verify-no-bugs.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "fastify",
    "typescript",
    "banking",
    "prisma",
    "queue"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^9.0.0",
    "@prisma/client": "^6.19.2",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.28.2",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "file-type": "^21.3.0",
    "ioredis": "^5.4.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "resend": "^6.9.4",
    "zod": "^3.24.1",
    "puppeteer": "^24.36.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.9",
    "@types/pdfkit": "^0.17.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "ts-jest": "^29.4.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
