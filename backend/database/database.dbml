  id text [pk, not null]
  user_id text [not null, ref: > users.id]
  loan_id text [ref: > loans.id]
  type varchar [not null]
  amount numeric [not null]
  currency text [not null]
  status varchar [not null]
  from_account text
  to_account text
  reference text
  description text
  metadata json
  processed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table users {
  id text [pk, not null]
  email text [not null]
  password_hash text [not null]
  first_name text [not null]
  last_name text [not null]
  phone_number text
  role varchar [not null]
  status varchar [not null]
  branch_id text [ref: > branches.id]
  must_change_password boolean [not null]
  password_changed_at timestamp
  national_id text
  line_user_id text
  line_linked_at timestamp
  line_active boolean [not null]
  line_notifications_enabled boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  last_login_at timestamp
  monthly_target numeric
}

Table year_interest_tiers {
  id text [pk, not null]
  loan_product_id text [not null, ref: > loan_products.id]
  tier_type text [not null]
  start_year int [not null]
  end_year text [not null]
  rate numeric
  formula text
  min_rate numeric
  max_rate numeric
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

